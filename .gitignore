# Frontend dependencies and build output
node_modules/
dist/

# Python virtual environments and caches
backend/.venv/
backend/.voice_clone_ready
**/__pycache__/
*.py[cod]

# Runtime state
backend/cache/
backend/reminders.sqlite3*
backend/logs/
backend/chat_history/
# Per-persona conversation memory is editable local runtime data.  Keep only
# documentation and the blank schema example in source control.
characters/memory/*
!characters/memory/README.md
!characters/memory/core_memory.example.json
reference_sounds/voice_clone_refs/

# Large downloaded backend models
models/backend/

# Local avatar files can be large and often forbid redistribution.
models/*.vrm

# Local tooling and editor files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.log
*.tmp
.tmp/
